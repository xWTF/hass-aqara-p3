# Only distributable code, tests and documentation belong in Git.
# New top-level directories are private by default; opt them in explicitly.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/LICENSE
!/hacs.json
!/pytest.ini
!/requirements-dev.txt
!/custom_components/
!/scripts/
!/tests_component/

# Python environments, caches and build output, including nested directories.
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.tox/
.nox/
.coverage
.coverage.*
coverage.xml
htmlcov/
build/
dist/
.zig-cache/
zig-out/

# Local settings, credentials, device state and debugging artifacts.
.env
.env.*
*.local.*
secrets.yaml
secrets.yml
credentials.json
.storage/
.codex/
.idea/
.vscode/
*.log
*.pcap
*.pcapng
*.sqlite*
*.db
*.pem
*.key
*.p12
*.pfx
*.zip
*.tar
*.gz
*.7z
*.bak
*.tmp
.DS_Store
Thumbs.db
