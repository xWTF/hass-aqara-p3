# Only distributable code, tests and documentation belong in Git.
# New top-level directories are private by default; opt them in explicitly.
/*
!/.gitignore
!/.gitattributes
!/.github/
!/README.md
!/LICENSE
!/hacs.json
!/pytest.ini
!/requirements-dev.txt
!/custom_components/
!/scripts/
!/tests_component/
!/.agents/
!/firmware/
/firmware/*
!/firmware/README.md
!/firmware/p3_firmware.py
!/firmware/apply.sh.in
!/firmware/4.0.4-user-init/
/firmware/4.0.4-user-init/*
!/firmware/4.0.4-user-init/kernel.bin
!/firmware/4.0.4-user-init/rootfs.bin
!/firmware/4.0.4-user-init/post_init.sh
!/firmware/4.0.4-user-init/manifest.json
!/firmware/4.0.4-user-init/SHA256SUMS
!/firmware/4.0.4-user-init/VALIDATION.md
/.agents/*
!/.agents/skills/
/.agents/skills/*
!/.agents/skills/aqara-p3-firmware/

# Skill sources only: keep firmware, lab output and device backups private.
/.agents/skills/aqara-p3-firmware/**/*.bin
/.agents/skills/aqara-p3-firmware/**/*.squashfs
/.agents/skills/aqara-p3-firmware/**/output*/
/.agents/skills/aqara-p3-firmware/**/work/

# Python environments, caches and build output, including nested directories.
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.tox/
.nox/
.coverage
.coverage.*
coverage.xml
htmlcov/
build/
dist/
.zig-cache/
zig-out/

# Local settings, credentials, device state and debugging artifacts.
.env
.env.*
*.local.*
secrets.yaml
secrets.yml
credentials.json
.storage/
.codex/
.idea/
.vscode/
*.log
*.pcap
*.pcapng
*.sqlite*
*.db
*.pem
*.key
*.p12
*.pfx
*.zip
*.tar
*.gz
*.7z
*.bak
*.tmp
.DS_Store
Thumbs.db
